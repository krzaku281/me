{
	"name": "me",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=26.13.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy baseLocale --emit-ts-declarations",
		"check": "yarn run paraglide:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"build:test": "BASE_PATH=/me SITE_ORIGIN=https://example.test GOATCOUNTER_URL=http://localhost:4174/gc/count BUILD_DIR=build-test vite build",
		"test:e2e": "yarn run build:test && playwright test",
		"test": "yarn run check && yarn run lint && yarn run test:e2e"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.14.0",
		"@eslint/js": "10.0.1",
		"@fontsource/fira-mono": "5.3.0",
		"@fontsource/noto-sans-arabic": "5.3.0",
		"@fontsource/noto-sans-bengali": "5.3.0",
		"@fontsource/noto-sans-devanagari": "5.3.0",
		"@fontsource/noto-sans-hebrew": "5.3.0",
		"@fontsource/noto-sans-jp": "5.3.1",
		"@fontsource/noto-sans-sc": "5.3.1",
		"@inlang/paraglide-js": "2.29.3",
		"@playwright/test": "1.65.0",
		"@sveltejs/adapter-static": "4.0.1",
		"@sveltejs/enhanced-img": "1.0.0",
		"@sveltejs/kit": "3.1.1",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@types/node": "26.6.6",
		"eslint": "10.14.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.24.0",
		"globals": "17.14.0",
		"prettier": "3.9.10",
		"prettier-plugin-svelte": "4.1.1",
		"satori": "0.63.2",
		"sharp": "0.35.5",
		"svelte": "5.57.3",
		"svelte-check": "4.7.8",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.1",
		"vite": "8.3.7"
	},
	"resolutions": {
		"satori/fflate": "0.7.5"
	}
}
